{
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.fontFamily": "MesloLGM Nerd Font",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "Ubuntu (WSL)": {
            "path": "C:\\Windows\\System32\\wsl.exe",
            "args": [
                "-d",
                "Ubuntu"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "terminal.integrated.shellIntegration.decorationsEnabled": "both",
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"]
        }
    ],
    "terminal.integrated.shellIntegration.enabled": true,
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-p>": false,
        "<C-j>": true,
        "<C-k>": true,
        "<Esc>": true
    },
    "editor.renderWhitespace": "all",
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "vim.leader": ",",
    "vim.hlsearch": true,
    "vim.highlightedyank.enable": true,
    "vim.easymotion": true,
    "vim.statusBarColors.visual": "",
    "vim.visualModeKeyBindingsNonRecursive": [],
    "vim.useCtrlKeys": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["u"],
            "commands": ["undo"]
        },
        {
            "before": ["<C-r>"],
            "commands": ["redo"]
        },
        {
            "before": ["leader", "."],
            "commands": [
                "editor.action.showHover"
            ]
        }        
    ],
    "editor.accessibilitySupport": "off",
    "cSpell.userWords": [
        "Colour",
        "Trademe"
    ],
    "cSpell.enabled": true,
    "editor.fontFamily": "Source Code Pro",
    "git.autofetch": true,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "workbench.editor.editorActionsLocation": "hidden",
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "terminal.integrated.enablePersistentSessions": false,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "jupyter.askForKernelRestart": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://zendriver.dev": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://www.electronjs.org/docs/latest": true,
        "https://www.electronjs.org/docs": true,
        "https://www.electronjs.org": true,
        "https://*.electronjs.org": true,
        "https://electron-vite.org": true,
        "https://www.electron.build": true,
        "https://*.electron.build": true,
        "https://www.electronjs.org/docs/latest/tutorial/context-isolation": true,
        "https://www.electronjs.org/docs/latest/tutorial": true,
        "https://github.com/clauderic/dnd-kit": true,
        "https://github.com/clauderic": true,
        "https://github.com": true,
        "https://github.com/react-beautiful-dnd/react-beautiful-dnd": true,
        "https://github.com/react-beautiful-dnd": true,
        "https://www.electronjs.org/docs/latest/tutorial/security": true,
        "https://www.electronforge.io": true,
        "https://*.electronforge.io": true,
        "https://github.com/atlassian/react-beautiful-dnd": true,
        "https://github.com/atlassian": true,
        "https://www.npmjs.com/package/react-beautiful-dnd": true,
        "https://www.npmjs.com/package": true,
        "https://www.npmjs.com": true,
        "https://*.npmjs.com": true,
        "https://transact.nzta.govt.nz": true
    },
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "python.terminal.useEnvFile": true,
    "python.analysis.typeCheckingMode": "standard",
    "workbench.browser.enableChatTools": true,
    "explorer.confirmDelete": false,
    "chat.tools.terminal.terminalProfile.windows": {
        "path": "C:\\Windows\\System32\\wsl.exe"
    },
    "chat.viewSessions.orientation": "stacked",
    "chat.agent.maxRequests": 200,
    "diffEditor.renderSideBySide": false,
    "github.copilot.enable": {
        "markdown": true
    }
}
