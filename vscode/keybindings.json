// Merged keybindings: IntelliJ-style keymap + VSCodeVim setup
// Order matters in this file: later rules win, and a "-command" rule removes
// any earlier matching rule. Sections are arranged accordingly.
[
    // ─────────────────────────────────────────────────────────────
    // VSCodeVim — free up the Ctrl keys the IntelliJ keymap needs
    // (removals must stay ABOVE the ctrl+q bindings below)
    // ─────────────────────────────────────────────────────────────
    // Stop vim stealing Ctrl+A (increment number) so Ctrl+A = Select All
    {
        "key": "ctrl+a",
        "command": "-extension.vim_ctrl+a",
        "when": "editorTextFocus && vim.active && vim.use<C-a> && !inDebugRepl"
    },
    // Stop vim stealing Ctrl+C so it stays a normal Copy
    {
        "key": "ctrl+c",
        "command": "-extension.vim_ctrl+c",
        "when": "editorTextFocus && vim.active && vim.overrideCtrlC && vim.use<C-c> && !inDebugRepl"
    },
    // Stop Ctrl+D adding another cursor while vim is on, so it can duplicate a line
    {
        "key": "ctrl+d",
        "command": "-editor.action.addSelectionToNextFindMatch",
        "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    // Stop vim stealing Ctrl+F (page down) so Ctrl+F = Find
    {
        "key": "ctrl+f",
        "command": "-extension.vim_ctrl+f",
        "when": "editorTextFocus && vim.active && vim.use<C-f> && !inDebugRepl && vim.mode != 'Insert'"
    },
    // Free Ctrl+J from vim
    {
        "key": "ctrl+j",
        "command": "-extension.vim_ctrl+j",
        "when": "editorTextFocus && vim.active && vim.use<C-j> && !inDebugRepl"
    },
    // Free Ctrl+K from vim so it can be Git Commit
    {
        "key": "ctrl+k",
        "command": "-extension.vim_ctrl+k",
        "when": "editorTextFocus && vim.active && vim.use<C-k> && !inDebugRepl && vim.mode != 'Insert'"
    },
    // Stop vim stealing Ctrl+N so it can be Go to Symbol in Workspace
    {
        "key": "ctrl+n",
        "command": "-extension.vim_ctrl+n",
        "when": "editorTextFocus && vim.active && vim.use<C-n> && !inDebugRepl || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'SearchInProgressMode'"
    },
    // Free Ctrl+T from vim so it can be Git Sync
    {
        "key": "ctrl+t",
        "command": "-extension.vim_ctrl+t",
        "when": "editorTextFocus && vim.active && vim.use<C-t> && !inDebugRepl"
    },
    // Stop vim stealing Ctrl+V so it stays a normal Paste (moved to Ctrl+Q)
    {
        "key": "ctrl+v",
        "command": "-extension.vim_ctrl+v",
        "when": "editorTextFocus && vim.active && vim.use<C-v> && !inDebugRepl"
    },
    // Stop vim stealing Ctrl+W so it can be Extend Selection
    {
        "key": "ctrl+w",
        "command": "-extension.vim_ctrl+w",
        "when": "editorTextFocus && vim.active && vim.use<C-w> && !inDebugRepl"
    },
    // Turn off vim's Ctrl+W J window navigation
    {
        "key": "ctrl+w j",
        "command": "-extension.vim_navigateDown",
        "when": "vim.active && vim.use<C-w> && !editorTextFocus"
    },
    // Turn off vim's Ctrl+W Ctrl+W window cycling
    {
        "key": "ctrl+w ctrl+w",
        "command": "-extension.vim_navigateGroups",
        "when": "vim.active && vim.use<C-w> && !editorTextFocus"
    },
    // Turn off vim's Ctrl+W H window navigation
    {
        "key": "ctrl+w h",
        "command": "-extension.vim_navigateLeft",
        "when": "vim.active && vim.use<C-w> && !editorTextFocus"
    },
    // Turn off vim's Ctrl+W L window navigation
    {
        "key": "ctrl+w l",
        "command": "-extension.vim_navigateRight",
        "when": "vim.active && vim.use<C-w> && !editorTextFocus"
    },
    // Turn off vim's Ctrl+W K window navigation
    {
        "key": "ctrl+w k",
        "command": "-extension.vim_navigateUp",
        "when": "vim.active && vim.use<C-w> && !editorTextFocus"
    },
    // Stop vim stealing Ctrl+Y so it can be Delete Line
    {
        "key": "ctrl+y",
        "command": "-extension.vim_ctrl+y",
        "when": "editorTextFocus && vim.active && vim.use<C-y> && !inDebugRepl"
    },
    // Clear vim's own Ctrl+Q binding before rebinding it below
    {
        "key": "ctrl+q",
        "command": "-extension.vim_winCtrlQ",
        "when": "editorTextFocus && vim.active && vim.use<C-q> && !inDebugRepl"
    },
    // Free Ctrl+Q from the view picker
    {
        "key": "ctrl+q",
        "command": "-workbench.action.quickOpenNavigateNextInViewPicker",
        "when": "inQuickOpen && inViewsPicker"
    },
    // Free Ctrl+Q from Quick Open View
    {
        "key": "ctrl+q",
        "command": "-workbench.action.quickOpenView"
    },
    // Ctrl+Q takes over vim's blockwise-visual (normally Ctrl+V, which is paste here)
    // Vim blockwise-visual mode (normally Ctrl+V, which is Paste here)
    {
        "key": "ctrl+q",
        "command": "extension.vim_ctrl+v",
        "when": "editorTextFocus && vim.active && vim.use<C-v> && !inDebugRepl"
    },
    // Vim: close the current split/window
    {
        "key": "ctrl+q",
        "command": "extension.vim_winCtrlQ"
    },

    // ─────────────────────────────────────────────────────────────
    // Clipboard / undo
    // ─────────────────────────────────────────────────────────────
    // Copy the selection
    {
        "command": "editor.action.clipboardCopyAction",
        "key": "ctrl+c"
    },
    // Copy the selection (alternative shortcut)
    {
        "command": "editor.action.clipboardCopyAction",
        "key": "ctrl+insert"
    },
    // Copy the selection (alternative shortcut)
    {
        "command": "editor.action.clipboardCopyAction",
        "key": "shift+ctrl+alt+0"
    },
    // Cut the selection
    {
        "command": "editor.action.clipboardCutAction",
        "key": "ctrl+x",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Cut the selection (alternative shortcut)
    {
        "command": "editor.action.clipboardCutAction",
        "key": "shift+delete",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Paste from the clipboard
    {
        "command": "editor.action.clipboardPasteAction",
        "key": "ctrl+v"
    },
    // Paste from the clipboard (alternative shortcut)
    {
        "command": "editor.action.clipboardPasteAction",
        "key": "shift+insert"
    },
    // Copy the path of the selected file
    {
        "command": "copyFilePath",
        "key": "shift+ctrl+c",
        "when": "!editorFocus && !terminalFocus"
    },
    // Undo
    {
        "command": "undo",
        "key": "ctrl+z"
    },
    // Undo (alternative shortcut)
    {
        "command": "undo",
        "key": "alt+backspace"
    },
    // Redo
    {
        "command": "redo",
        "key": "shift+ctrl+z"
    },
    // Redo (alternative shortcut)
    {
        "command": "redo",
        "key": "shift+alt+backspace"
    },
    // Undo the last cursor movement (text stays as it is)
    {
        "command": "cursorUndo",
        "key": "shift+alt+j",
        "when": "textInputFocus"
    },

    // ─────────────────────────────────────────────────────────────
    // IntelliSense / hover / quick fix
    // ─────────────────────────────────────────────────────────────
    // Show code completion suggestions
    {
        "command": "editor.action.triggerSuggest",
        "key": "ctrl+space",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
    },
    // Accept the highlighted completion suggestion
    {
        "command": "acceptSelectedSuggestion",
        "key": "shift+ctrl+enter",
        "when": "suggestWidgetVisible && textInputFocus"
    },
    // Accept the highlighted completion suggestion
    {
        "command": "acceptSelectedSuggestion",
        "key": "shift+ctrl+enter",
        "when": "acceptSuggestionOnEnter && suggestWidgetVisible && suggestionMakesTextEdit && textInputFocus"
    },
    // Show the parameter hints for the function you are typing
    {
        "command": "editor.action.triggerParameterHints",
        "key": "ctrl+p",
        "when": "editorHasSignatureHelpProvider && editorTextFocus"
    },
    // Ctrl+F1 = documentation popup, Ctrl+Shift+F1 = error/warning details
    // Show the documentation popup for whatever is under the cursor
    {
        "command": "editor.action.showHover",
        "key": "ctrl+f1"
    },
    // Show the details of the error or warning under the cursor
    {
        "command": "workbench.action.showErrorsWarnings",
        "key": "shift+ctrl+f1",
        "when": "editorTextFocus"
    },
    // Show quick fixes and refactorings (the light bulb menu)
    {
        "command": "editor.action.quickFix",
        "key": "alt+enter",
        "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
    },
    // Jump to the next error or warning in the file
    {
        "command": "editor.action.marker.next",
        "key": "f2",
        "when": "editorFocus"
    },
    // Jump to the previous error or warning in the file
    {
        "command": "editor.action.marker.prev",
        "key": "shift+f2",
        "when": "editorFocus"
    },

    // ─────────────────────────────────────────────────────────────
    // Comments
    // ─────────────────────────────────────────────────────────────
    // Comment or uncomment the current line
    {
        "command": "editor.action.commentLine",
        "key": "ctrl+/",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Comment or uncomment the current line (alternative shortcut)
    {
        "command": "editor.action.commentLine",
        "key": "ctrl+alt+/",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Comment or uncomment the current line (numpad shortcut)
    {
        "command": "editor.action.commentLine",
        "key": "ctrl+alt+numpad_divide",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Comment or uncomment the selection as a block comment
    {
        "command": "editor.action.blockComment",
        "key": "shift+ctrl+/",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Block comment the selection (numpad shortcut)
    {
        "command": "editor.action.blockComment",
        "key": "shift+ctrl+numpad_divide",
        "when": "editorTextFocus && !editorReadonly"
    },

    // ─────────────────────────────────────────────────────────────
    // Folding
    // ─────────────────────────────────────────────────────────────
    // Collapse every foldable section in the file
    {
        "command": "editor.foldAll",
        "key": "shift+ctrl+numpad_subtract",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Expand every collapsed section in the file
    {
        "command": "editor.unfoldAll",
        "key": "shift+ctrl+numpad_add",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Collapse the block at the cursor
    {
        "command": "editor.fold",
        "key": "ctrl+numpad_subtract",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Collapse the block at the cursor (alternative shortcut)
    {
        "command": "editor.fold",
        "key": "ctrl+-",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Collapse the block at the cursor and everything inside it
    {
        "command": "editor.foldRecursively",
        "key": "ctrl+alt+numpad_subtract",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Collapse the block and everything inside it (alternative shortcut)
    {
        "command": "editor.foldRecursively",
        "key": "ctrl+alt+-",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Expand the block at the cursor
    {
        "command": "editor.unfold",
        "key": "ctrl+numpad_add",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Expand the block at the cursor (alternative shortcut)
    {
        "command": "editor.unfold",
        "key": "ctrl+=",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Expand the block at the cursor and everything inside it
    {
        "command": "editor.unfoldRecursively",
        "key": "ctrl+alt+numpad_add",
        "when": "editorTextFocus && foldingEnabled"
    },
    // Expand the block and everything inside it (alternative shortcut)
    {
        "command": "editor.unfoldRecursively",
        "key": "ctrl+alt+=",
        "when": "editorTextFocus && foldingEnabled"
    },

    // ─────────────────────────────────────────────────────────────
    // Line editing
    // ─────────────────────────────────────────────────────────────
    // Delete the whole current line
    {
        "command": "editor.action.deleteLines",
        "key": "ctrl+y",
        "when": "textInputFocus && !editorReadonly"
    },
    // Delete the word to the right of the cursor
    {
        "command": "deleteWordRight",
        "key": "ctrl+delete",
        "when": "textInputFocus && !editorReadonly && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    // Delete the word to the left of the cursor
    {
        "command": "deleteWordLeft",
        "key": "ctrl+backspace",
        "when": "textInputFocus && !editorReadonly && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    // Ctrl+D: duplicate line in the editor, open diff everywhere else.
    // These two must stay in this order — the second one wins where it applies.
    // Open the diff for the current file
    {
        "command": "git.openChange",
        "key": "ctrl+d"
    },
    // Duplicate the current line below
    {
        "command": "editor.action.copyLinesDownAction",
        "key": "ctrl+d",
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
    },
    // Join the next line onto the current one
    {
        "command": "editor.action.joinLines",
        "key": "shift+ctrl+j",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Move the current line (or selection) down
    {
        "command": "editor.action.moveLinesDownAction",
        "key": "shift+alt+down",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Move the current line (or selection) up
    {
        "command": "editor.action.moveLinesUpAction",
        "key": "shift+alt+up",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Start a new line below, wherever the cursor is
    {
        "command": "editor.action.insertLineAfter",
        "key": "shift+enter",
        "when": "editorTextFocus && !editorReadonly && !notebookEditorFocused"
    },
    // Start a new line below, wherever the cursor is
    {
        "command": "editor.action.insertLineAfter",
        "key": "shift+enter",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible"
    },
    // Start a new line above, wherever the cursor is
    {
        "command": "editor.action.insertLineBefore",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Insert a line break without moving the cursor
    {
        "command": "lineBreakInsert",
        "key": "ctrl+enter",
        "when": "textInputFocus && !editorReadonly"
    },
    // Tidy up and sort the import statements
    {
        "command": "editor.action.organizeImports",
        "key": "ctrl+alt+o",
        "when": "editorTextFocus && !editorReadonly && supportedCodeAction =~ /(\\s|^)source\\.organizeImports\\b/"
    },
    // Reformat the whole file
    {
        "command": "editor.action.formatDocument",
        "key": "ctrl+alt+l",
        "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
    },
    // Rename the symbol under the cursor everywhere it is used
    {
        "command": "editor.action.rename",
        "key": "shift+f6",
        "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
    },

    // ─────────────────────────────────────────────────────────────
    // Selection & cursor movement
    // ─────────────────────────────────────────────────────────────
    // Widen the selection to the next enclosing block
    {
        "command": "editor.action.smartSelect.grow",
        "key": "ctrl+w",
        "when": "editorTextFocus"
    },
    // Shrink the selection back in one step
    {
        "command": "editor.action.smartSelect.shrink",
        "key": "shift+ctrl+w",
        "when": "editorTextFocus"
    },
    // Switch column (rectangular) selection mode on or off
    {
        "command": "editor.action.toggleColumnSelection",
        "key": "shift+alt+insert"
    },
    // Select every occurrence of the current word at once
    {
        "command": "editor.action.selectHighlights",
        "key": "shift+ctrl+alt+j",
        "when": "editorFocus"
    },
    // Add the next matching occurrence to the selection
    {
        "command": "editor.action.addSelectionToNextFindMatch",
        "key": "alt+j",
        "when": "editorFocus"
    },
    // Move to the end of the line
    {
        "command": "cursorLineEnd",
        "key": "end",
        "when": "textInputFocus"
    },
    // Select to the end of the line
    {
        "command": "cursorLineEndSelect",
        "key": "shift+end",
        "when": "textInputFocus"
    },
    // Move to the start of the line
    {
        "command": "cursorLineStart",
        "key": "home",
        "when": "textInputFocus"
    },
    // Select to the start of the line
    {
        "command": "cursorLineStartSelect",
        "key": "shift+home",
        "when": "textInputFocus"
    },
    // Move to the end of the file
    {
        "command": "cursorBottom",
        "key": "ctrl+pagedown",
        "when": "textInputFocus"
    },
    // Select all the way to the end of the file
    {
        "command": "cursorBottomSelect",
        "key": "shift+ctrl+pagedown",
        "when": "textInputFocus"
    },
    // Move to the top of the file
    {
        "command": "cursorTop",
        "key": "ctrl+pageup",
        "when": "textInputFocus"
    },
    // Select all the way to the top of the file
    {
        "command": "cursorTopSelect",
        "key": "shift+ctrl+pageup",
        "when": "textInputFocus"
    },
    // Move to the end of the file (alternative shortcut)
    {
        "command": "cursorBottom",
        "key": "ctrl+end",
        "when": "textInputFocus"
    },
    // Move to the top of the file (alternative shortcut)
    {
        "command": "cursorTop",
        "key": "ctrl+home",
        "when": "textInputFocus"
    },
    // Move down one screen
    {
        "command": "cursorPageDown",
        "key": "pagedown",
        "when": "textInputFocus"
    },
    // Select down one screen
    {
        "command": "cursorPageDownSelect",
        "key": "shift+pagedown",
        "when": "textInputFocus"
    },
    // Move up one screen
    {
        "command": "cursorPageUp",
        "key": "pageup",
        "when": "textInputFocus"
    },
    // Select up one screen
    {
        "command": "cursorPageUpSelect",
        "key": "shift+pageup",
        "when": "textInputFocus"
    },
    // Move to the start of the next word
    {
        "command": "cursorWordRight",
        "key": "ctrl+right",
        "when": "editorTextFocus && !inlineSuggestionVisible && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    // Select to the start of the next word
    {
        "command": "cursorWordRightSelect",
        "key": "shift+ctrl+right",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    // Move to the start of the previous word
    {
        "command": "cursorWordLeft",
        "key": "ctrl+left",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },
    // Select to the start of the previous word
    {
        "command": "cursorWordLeftSelect",
        "key": "shift+ctrl+left",
        "when": "editorTextFocus && !config.intellij-idea-keybindings.useCamelHumpsWords"
    },

    // ─────────────────────────────────────────────────────────────
    // Find & replace
    // ─────────────────────────────────────────────────────────────
    // Jump to the next search match
    {
        "command": "editor.action.nextMatchFindAction",
        "key": "f3",
        "when": "editorFocus"
    },
    // Jump to the next search match
    {
        "command": "editor.action.nextMatchFindAction",
        "key": "f3",
        "when": "editorFocus && findInputFocussed"
    },
    // Jump to the next search match (alternative shortcut)
    {
        "command": "editor.action.nextMatchFindAction",
        "key": "ctrl+l",
        "when": "editorFocus"
    },
    // Jump to the next search match (alternative shortcut)
    {
        "command": "editor.action.nextMatchFindAction",
        "key": "ctrl+l",
        "when": "editorFocus && findInputFocussed"
    },
    // Jump to the previous search match
    {
        "command": "editor.action.previousMatchFindAction",
        "key": "shift+f3",
        "when": "editorFocus"
    },
    // Jump to the previous search match
    {
        "command": "editor.action.previousMatchFindAction",
        "key": "shift+f3",
        "when": "editorFocus && findInputFocussed"
    },
    // Jump to the previous search match (alternative shortcut)
    {
        "command": "editor.action.previousMatchFindAction",
        "key": "shift+ctrl+l",
        "when": "editorFocus"
    },
    // Jump to the previous search match (alternative shortcut)
    {
        "command": "editor.action.previousMatchFindAction",
        "key": "shift+ctrl+l",
        "when": "editorFocus && findInputFocussed"
    },
    // Find and replace in this file
    {
        "command": "editor.action.startFindReplaceAction",
        "key": "ctrl+r",
        "when": "editorFocus || editorIsOpen"
    },
    // Search across all files in the project
    {
        "command": "workbench.action.findInFiles",
        "key": "shift+ctrl+f"
    },
    // Search across all files in the project
    {
        "command": "workbench.action.findInFiles",
        "key": "shift+ctrl+f",
        "when": "!explorerResourceIsFolder || !filesExplorerFocus"
    },
    // Find and replace across all files in the project
    {
        "command": "workbench.action.replaceInFiles",
        "key": "shift+ctrl+r"
    },

    // ─────────────────────────────────────────────────────────────
    // Navigation / go to
    // ─────────────────────────────────────────────────────────────
    // Go back to where you were before
    {
        "command": "workbench.action.navigateBack",
        "key": "ctrl+alt+left",
        "when": "canNavigateBack"
    },
    // Go forward again after going back
    {
        "command": "workbench.action.navigateForward",
        "key": "shift+ctrl+-",
        "when": "canNavigateForward"
    },
    // Jump to the last place you edited
    {
        "command": "workbench.action.navigateToLastEditLocation",
        "key": "shift+ctrl+backspace"
    },
    // Go to where this symbol is defined
    {
        "command": "editor.action.goToDeclaration",
        "key": "f4",
        "when": "editorTextFocus"
    },
    // Go to the implementation of this symbol
    {
        "command": "editor.action.goToImplementation",
        "key": "ctrl+alt+b",
        "when": "editorHasImplementationProvider && editorTextFocus && !isInEmbeddedEditor"
    },
    // Go to the definition of this symbol's type
    {
        "command": "editor.action.goToTypeDefinition",
        "key": "shift+ctrl+b",
        "when": "editorTextFocus"
    },
    // Peek at the definition without leaving the file
    {
        "command": "editor.action.previewDeclaration",
        "key": "shift+ctrl+i"
    },
    // List everywhere this symbol is used
    {
        "command": "references-view.findReferences",
        "key": "alt+f7",
        "when": "editorHasReferenceProvider"
    },
    // Peek at all the usages of this symbol inline
    {
        "command": "editor.action.referenceSearch.trigger",
        "key": "ctrl+alt+f7",
        "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor"
    },
    // Show what calls this function, and what it calls
    {
        "command": "references-view.showCallHierarchy",
        "key": "ctrl+alt+h",
        "when": "editorHasCallHierarchyProvider"
    },
    // Show the class hierarchy (Java files only)
    {
        "command": "java.action.showTypeHierarchy",
        "key": "ctrl+h",
        "when": "editorLangId == java && javaLSReady && editorTextFocus"
    },
    // Jump to a symbol inside the current file
    {
        "command": "workbench.action.gotoSymbol",
        "key": "ctrl+f12",
